# Copy to deploy/.env before running docker compose. Do not commit the copy —
# .gitignore excludes .env and permits this file.
#
# The composition needs none of these to start. Everything the platform is
# configured with is a flag on the `command:` in docker-compose.yml; this file
# only carries the build stamps and the one credential any code reads.

# Only read under `serve --model=anthropic`, which docker-compose.yml does not
# use. Leave it empty for the deterministic planner, which sends nothing
# anywhere. agent.NewAnthropicModel errors rather than falling back when it is
# unset, so a missing key is a startup failure and not a silent downgrade.
ANTHROPIC_API_KEY=

# Build stamps. Passed as build args, baked in with -ldflags -X, and surfaced by
# `tcrpd version` and GET /v1/version.
VERSION=0.0.0-dev
COMMIT=unknown
BUILT_AT=unknown

# POSTGRES_PASSWORD and TCRP_SIGNING_SECRET used to be here and are gone. The
# composition has no Postgres — no Go file in this repository opens a database
# connection — and the identity signer's HMAC secret is the compile-time literal
# "tcrp-dev-signing-key" in internal/platform/platform.go, which no environment
# variable overrides.
